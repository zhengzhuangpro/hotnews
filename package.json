{
  "name": "hotnews",
  "version": "0.1.7-beta.1",
  "description": "热门新闻聚合工具，支持百度、微博、抖音、虎扑等 11 个平台；可用作 CLI 或 npm 库导入",
  "keywords": [
    "cli",
    "library",
    "news",
    "hotnews",
    "baidu",
    "weibo",
    "douyin",
    "hupu",
    "trending"
  ],
  "author": "zhengzhuang <zhengzhuangpro@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhengzhuangpro/hotnews.git"
  },
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "hotnews": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_en.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "dev": "bun run --watch src/cli.tsx",
    "start": "bun run src/cli.tsx",
    "build": "bun scripts/build.ts",
    "check": "bun scripts/check.ts",
    "smoke": "node scripts/smoke.cjs",
    "test": "bun test",
    "release": "bun scripts/release.ts patch",
    "beta": "bun scripts/release.ts prerelease --preid=beta",
    "gh-release": "git push --tags && gh release create v$(node -p \"require('./package.json').version\") --generate-notes"
  },
  "dependencies": {
    "ink": "^7.0.1",
    "meow": "^14.1.0",
    "react": "^19.1.0",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
